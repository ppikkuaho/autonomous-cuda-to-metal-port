+def _debug_stats(tensor: torch.Tensor) -> Dict[str, Any]:
+    if tensor.numel() == 0:
+        return {"shape": list(tensor.shape), "numel": 0, "dtype": str(tensor.dtype), "device": str(tensor.device)}
+    data = tensor.detach().float()
+    finite = torch.isfinite(data)
+    finite_data = data[finite]
+    stats = {
+        "shape": list(tensor.shape),
+        "numel": int(tensor.numel()),
+        "dtype": str(tensor.dtype),
+        "device": str(tensor.device),
+        "nan_count": int(torch.isnan(data).sum().item()),
+        "inf_count": int(torch.isinf(data).sum().item()),
+    }
+    if finite_data.numel() > 0:
+        stats.update({
+            "min": float(finite_data.min().item()),
+            "max": float(finite_data.max().item()),
+            "mean": float(finite_data.mean().item()),
+            "std": float(finite_data.std(unbiased=False).item()),
+        })
+    return stats
+
+
