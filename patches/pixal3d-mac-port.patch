+def _debug_dir() -> Optional[str]:
+    path = os.environ.get("PIXAL3D_DEBUG_ARTIFACT_DIR")
+    if not path:
+        return None
+    os.makedirs(path, exist_ok=True)
+    return path
+
+
+def _as_float_stats(tensor: torch.Tensor) -> Dict[str, Any]:
+    if tensor.numel() == 0:
+        return {
+            "shape": list(tensor.shape),
+            "dtype": str(tensor.dtype),
+            "device": str(tensor.device),
+            "numel": 0,
+        }
+    data = tensor.detach().float()
+    finite = torch.isfinite(data)
+    finite_data = data[finite]
+    stats = {
+        "shape": list(tensor.shape),
+        "dtype": str(tensor.dtype),
+        "device": str(tensor.device),
+        "numel": int(tensor.numel()),
+        "nan_count": int(torch.isnan(data).sum().item()),
+        "inf_count": int(torch.isinf(data).sum().item()),
+        "zero_fraction": float((data == 0).float().mean().item()),
+    }
+    if finite_data.numel() > 0:
+        stats.update({
+            "min": float(finite_data.min().item()),
+            "max": float(finite_data.max().item()),
+            "mean": float(finite_data.mean().item()),
+            "std": float(finite_data.std(unbiased=False).item()),
+        })
+    return stats
+
+
+def _debug_write(stage: str, payload: Dict[str, Any]) -> None:
+    path = _debug_dir()
+    if path is None:
+        return
+    with open(os.path.join(path, "tensor_summaries.jsonl"), "a", encoding="utf-8") as f:
+        f.write(json.dumps({"stage": stage, **payload}, sort_keys=True) + "\n")
+
+
+def _debug_tensor(stage: str, name: str, tensor: torch.Tensor) -> None:
+    _debug_write(stage, {"name": name, "tensor": _as_float_stats(tensor)})
+
+
+def _debug_sparse(stage: str, name: str, sparse: SparseTensor) -> None:
+    payload = {
+        "name": name,
+        "type": "SparseTensor",
+        "feats": _as_float_stats(sparse.feats),
+        "coords": _as_float_stats(sparse.coords),
+    }
+    if sparse.coords.numel() > 0:
+        coords = sparse.coords.detach().cpu()
+        payload["coord_min"] = coords.min(dim=0).values.tolist()
+        payload["coord_max"] = coords.max(dim=0).values.tolist()
+        payload["coord_count"] = int(coords.shape[0])
+    _debug_write(stage, payload)
+
+
+def _debug_save_sparse(stage: str, name: str, sparse: SparseTensor) -> None:
