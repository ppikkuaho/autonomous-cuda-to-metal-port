+from natten_mps import na2d as _na2d
+
+
+def na2d(query, key, value, kernel_size, dilation=1, stride=1, backend=None, **kwargs):
+    """Compatibility wrapper for recent NATTEN API calls used by NAF."""
+    return _na2d(
+        query,
+        key,
+        value,
+        kernel_size=kernel_size,
+        dilation=dilation,
+        stride=stride,
+        **kwargs,
+    )
+
+
+__all__ = ["na2d"]
