+def _segment_reduce_varlen(values: torch.Tensor, reduce: str, lengths: torch.Tensor) -> torch.Tensor:
+    if values.device.type != 'mps':
+        return torch.segment_reduce(values, reduce=reduce, lengths=lengths)
+
+    outputs = []
+    start = 0
+    trailing_shape = values.shape[1:]
+    for length in lengths.detach().cpu().tolist():
+        length = int(length)
+        chunk = values.narrow(0, start, length)
+        start += length
+        if length == 0:
+            if reduce == 'sum':
+                outputs.append(values.new_zeros(trailing_shape))
+            elif reduce == 'prod':
+                outputs.append(values.new_ones(trailing_shape))
+            elif reduce == 'mean':
+                outputs.append(values.new_full(trailing_shape, float('nan')))
+            else:
+                raise ValueError(f"Unsupported reduce operation: {reduce}")
+        elif reduce == 'mean':
+            outputs.append(chunk.mean(dim=0))
+        elif reduce == 'sum':
+            outputs.append(chunk.sum(dim=0))
+        elif reduce == 'prod':
+            outputs.append(chunk.prod(dim=0))
+        else:
+            raise ValueError(f"Unsupported reduce operation: {reduce}")
+    if not outputs:
+        return values.new_empty((0, *trailing_shape))
+    return torch.stack(outputs, dim=0)
