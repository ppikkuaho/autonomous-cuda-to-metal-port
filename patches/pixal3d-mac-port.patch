diff --git a/pixal3d/modules/sparse/conv/conv_none.py b/pixal3d/modules/sparse/conv/conv_none.py
new file mode 100644
index 0000000..3a1dc8e
--- /dev/null
+++ b/pixal3d/modules/sparse/conv/conv_none.py
@@ -0,0 +1,209 @@
+"""
+Pure PyTorch sparse 3D convolution backend.
+
+This backend implements the same submanifold convolution contract as the
+flex_gemm backend, but avoids CUDA extensions. It is intended as the portable
+Apple Silicon fallback; performance is expected to be much slower than fused
+CUDA/Metal kernels.
+"""
+
+import hashlib
+import math
+import os
+
+import numpy as np
+import torch
+import torch.nn as nn
+
+from .. import SparseTensor
+
+
+def _coords_hash_index(coords_cpu: torch.Tensor, dilation: tuple[int, int, int]):
+    coords_np = coords_cpu.numpy().astype(np.int64, copy=False)
+    margin = max(dilation) + 1
+    mins = coords_np.min(axis=0)
+    maxs = coords_np.max(axis=0)
+    shift = -mins + margin
+    dims = (maxs - mins) + (2 * margin + 1)
+
+    def make_keys(offset=(0, 0, 0)):
+        b = coords_np[:, 0] + shift[0]
+        z = coords_np[:, 1] + offset[0] + shift[1]
+        y = coords_np[:, 2] + offset[1] + shift[2]
+        x = coords_np[:, 3] + offset[2] + shift[3]
+        return (((b * dims[1] + z) * dims[2] + y) * dims[3] + x).astype(np.int64, copy=False)
+
+    keys = make_keys()
+    order = np.argsort(keys, kind="mergesort")
+    if keys.shape[0] > 1:
+        sorted_keys_for_dupes = keys[order]
+        if np.any(sorted_keys_for_dupes[1:] == sorted_keys_for_dupes[:-1]):
+            raise ValueError("Duplicate sparse coordinate is not supported by conv_none")
+    return coords_np, make_keys, keys[order], order
+
+
+def sparse_conv3d_init(self, in_channels, out_channels, kernel_size, stride=1, dilation=1, padding=None, bias=True, indice_key=None):
+    assert stride == 1 and (padding is None), \
+        "Pure PyTorch backend only supports submanifold sparse convolution (stride=1, padding=None)"
+
+    self.in_channels = in_channels
+    self.out_channels = out_channels
+    self.kernel_size = tuple(kernel_size) if isinstance(kernel_size, (list, tuple)) else (kernel_size,) * 3
+    self.stride = tuple(stride) if isinstance(stride, (list, tuple)) else (stride,) * 3
+    self.dilation = tuple(dilation) if isinstance(dilation, (list, tuple)) else (dilation,) * 3
+
+    self.weight = nn.Parameter(torch.empty((out_channels, in_channels, *self.kernel_size)))
+    if bias:
+        self.bias = nn.Parameter(torch.empty(out_channels))
+    else:
+        self.register_parameter("bias", None)
+
+    torch.nn.init.kaiming_uniform_(self.weight, a=math.sqrt(5))
+    if self.bias is not None:
+        fan_in, _ = torch.nn.init._calculate_fan_in_and_fan_out(self.weight)
+        if fan_in != 0:
+            bound = 1 / math.sqrt(fan_in)
+            torch.nn.init.uniform_(self.bias, -bound, bound)
+
+    # Match flex_gemm layout: (Co, Ci, Kd, Kh, Kw) -> (Co, Kd, Kh, Kw, Ci).
+    self.weight = nn.Parameter(self.weight.permute(0, 2, 3, 4, 1).contiguous())
+
+
+def sparse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    Co, Kd, Kh, Kw, Ci = self.weight.shape
+    device = x.feats.device
+    dtype = x.feats.dtype
+
+    coords = x.coords
+    feats = x.feats
+    num_voxels = coords.shape[0]
+    if num_voxels == 0:
+        out = torch.zeros(0, Co, device=device, dtype=dtype)
+        if self.bias is not None:
+            out = out + self.bias
+        return x.replace(out)
+    stream_threshold = int(os.environ.get("PIXAL3D_CONV_NONE_STREAM_THRESHOLD", "0") or "0")
+    stream_edges = os.environ.get("PIXAL3D_CONV_NONE_STREAM", "0") == "1" or (
+        stream_threshold > 0 and num_voxels >= stream_threshold
+    )
+
+    cache_key = f"SubMConv3d_none_neighbor_cache_{Kw}x{Kh}x{Kd}_dilation{self.dilation}"
+    coords_cpu = coords.detach().cpu().contiguous()
+    coords_signature = (
+        tuple(coords_cpu.shape),
+        hashlib.sha1(coords_cpu.numpy().tobytes()).hexdigest(),
+    )
+    cached = None if stream_edges else x.get_spatial_cache(cache_key)
+    neighbor_cache = None
+    if cached is not None and cached[0] == coords_signature:
+        neighbor_cache = cached[1]
+
+    if neighbor_cache is None and not stream_edges:
+        coord_to_idx = {}
+        for idx in range(num_voxels):
+            key = tuple(coords_cpu[idx].tolist())
+            if key in coord_to_idx:
+                raise ValueError(f"Duplicate sparse coordinate is not supported by conv_none: {key}")
+            coord_to_idx[key] = idx
+
+        dz, dy, dx = self.dilation
+        src_indices = []
+        tgt_indices = []
+        kernel_indices = []
+
+        for kz in range(Kd):
+            for ky in range(Kh):
+                for kx in range(Kw):
+                    oz = (kz - Kd // 2) * dz
+                    oy = (ky - Kh // 2) * dy
+                    ox = (kx - Kw // 2) * dx
+                    kernel_idx = kz * Kh * Kw + ky * Kw + kx
+
+                    for tgt_idx in range(num_voxels):
+                        b, z, y, x_coord = coords_cpu[tgt_idx].tolist()
+                        src_key = (b, z + oz, y + oy, x_coord + ox)
+                        src_idx = coord_to_idx.get(src_key)
+                        if src_idx is not None:
+                            src_indices.append(src_idx)
+                            tgt_indices.append(tgt_idx)
+                            kernel_indices.append(kernel_idx)
+
+        neighbor_cache = (
+            torch.tensor(src_indices, dtype=torch.long, device=device),
+            torch.tensor(tgt_indices, dtype=torch.long, device=device),
+            torch.tensor(kernel_indices, dtype=torch.long, device=device),
+        )
+        x.register_spatial_cache(cache_key, (coords_signature, neighbor_cache))
+
+    kernel_count = Kd * Kh * Kw
+    weight = self.weight.reshape(Co, kernel_count, Ci).permute(1, 2, 0)
+
+    out = torch.zeros(num_voxels, Co, device=device, dtype=dtype)
+    edge_chunk_size = int(os.environ.get("PIXAL3D_CONV_NONE_EDGE_CHUNK", "0") or "0")
+
+    if stream_edges:
+        index_key = f"SubMConv3d_none_hash_index_dilation{self.dilation}"
+        index_cached = x.get_spatial_cache(index_key)
+        if index_cached is not None and index_cached[0] == coords_signature:
+            coords_np, make_keys, sorted_keys, sorted_order = index_cached[1]
+        else:
+            coords_np, make_keys, sorted_keys, sorted_order = _coords_hash_index(coords_cpu, self.dilation)
+            x.register_spatial_cache(index_key, (coords_signature, (coords_np, make_keys, sorted_keys, sorted_order)))
+
+        dz, dy, dx = self.dilation
+        for kz in range(Kd):
+            for ky in range(Kh):
+                for kx in range(Kw):
+                    oz = (kz - Kd // 2) * dz
+                    oy = (ky - Kh // 2) * dy
+                    ox = (kx - Kw // 2) * dx
+                    k = kz * Kh * Kw + ky * Kw + kx
+
+                    neighbor_keys = make_keys((oz, oy, ox))
+                    pos = np.searchsorted(sorted_keys, neighbor_keys)
+                    in_range = pos < sorted_keys.shape[0]
+                    found = np.zeros(neighbor_keys.shape[0], dtype=bool)
+                    found[in_range] = sorted_keys[pos[in_range]] == neighbor_keys[in_range]
+                    if not found.any():
+                        continue
+                    edge_tgt_np = np.nonzero(found)[0].astype(np.int64, copy=False)
+                    edge_src_np = sorted_order[pos[found]].astype(np.int64, copy=False)
+                    edge_src = torch.from_numpy(edge_src_np).to(device=device)
+                    edge_tgt = torch.from_numpy(edge_tgt_np).to(device=device)
+                    if edge_chunk_size > 0 and edge_src.numel() > edge_chunk_size:
+                        for start in range(0, edge_src.numel(), edge_chunk_size):
+                            stop = min(start + edge_chunk_size, edge_src.numel())
+                            edge_out = feats[edge_src[start:stop]] @ weight[k]
+                            out.index_add_(0, edge_tgt[start:stop], edge_out)
+                    else:
+                        edge_out = feats[edge_src] @ weight[k]
+                        out.index_add_(0, edge_tgt, edge_out)
+    else:
+        src_idx, tgt_idx, kernel_idx = neighbor_cache
+        for k in range(kernel_count):
+            mask = kernel_idx == k
+            if not torch.any(mask):
+                continue
+            edge_src = src_idx[mask]
+            edge_tgt = tgt_idx[mask]
+            if edge_chunk_size > 0 and edge_src.numel() > edge_chunk_size:
+                for start in range(0, edge_src.numel(), edge_chunk_size):
+                    stop = min(start + edge_chunk_size, edge_src.numel())
+                    edge_out = feats[edge_src[start:stop]] @ weight[k]
+                    out.index_add_(0, edge_tgt[start:stop], edge_out)
+            else:
+                edge_out = feats[edge_src] @ weight[k]
+                out.index_add_(0, edge_tgt, edge_out)
+
+    if self.bias is not None:
+        out = out + self.bias
+
+    return x.replace(out)
+
+
+def sparse_inverse_conv3d_init(self, *args, **kwargs):
+    raise NotImplementedError("SparseInverseConv3d with conv_none is not implemented")
+
+
+def sparse_inverse_conv3d_forward(self, x: SparseTensor) -> SparseTensor:
+    raise NotImplementedError("SparseInverseConv3d with conv_none is not implemented")
