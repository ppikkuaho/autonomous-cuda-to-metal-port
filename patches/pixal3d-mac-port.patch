@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+from typing import Union
+
+import torch
+
+
+def mesh_to_flexible_dual_grid(*args, **kwargs):
+    raise RuntimeError("mesh_to_flexible_dual_grid requires o_voxel and is not part of the Mac inference fallback")
+
+
+def _tensor(value, *, dtype, device):
+    if isinstance(value, torch.Tensor):
+        return value.to(device=device, dtype=dtype)
+    return torch.tensor(value, dtype=dtype, device=device)
+
+
+def flexible_dual_grid_to_mesh(
+    coords: torch.Tensor,
+    dual_vertices: torch.Tensor,
+    intersected_flag: torch.Tensor,
+    split_weight: Union[torch.Tensor, None],
+    aabb,
+    voxel_size=None,
+    grid_size=None,
+    train: bool = False,
+):
+    if train:
+        raise RuntimeError("Training mode is not supported by the Mac mesh extraction fallback")
+
+    device = coords.device
+    coords = coords.to(dtype=torch.long)
+    intersected_flag = intersected_flag.to(dtype=torch.bool)
+
+    if coords.numel() == 0 or dual_vertices.numel() == 0:
+        return (
+            torch.zeros(0, 3, dtype=dual_vertices.dtype, device=device),
+            torch.zeros(0, 3, dtype=torch.long, device=device),
+        )
+
+    aabb = _tensor(aabb, dtype=dual_vertices.dtype, device=device)
+    if voxel_size is not None:
+        voxel_size = _tensor(voxel_size if not isinstance(voxel_size, (int, float)) else [voxel_size] * 3, dtype=dual_vertices.dtype, device=device)
+    else:
+        if grid_size is None:
+            raise ValueError("Either voxel_size or grid_size must be provided")
+        grid_size = _tensor(grid_size if not isinstance(grid_size, int) else [grid_size] * 3, dtype=dual_vertices.dtype, device=device)
+        voxel_size = (aabb[1] - aabb[0]) / grid_size
+
+    edge_neighbor_voxel_offset = torch.tensor(
+        [
+            [[0, 0, 0], [0, 0, 1], [0, 1, 1], [0, 1, 0]],
+            [[0, 0, 0], [1, 0, 0], [1, 0, 1], [0, 0, 1]],
+            [[0, 0, 0], [0, 1, 0], [1, 1, 0], [1, 0, 0]],
+        ],
+        dtype=torch.long,
+        device=device,
+    ).unsqueeze(0)
+    quad_split_1 = torch.tensor([0, 1, 2, 0, 2, 3], dtype=torch.long, device=device)
+    quad_split_2 = torch.tensor([0, 1, 3, 3, 1, 2], dtype=torch.long, device=device)
+
+    coord_to_idx = {}
+    coords_cpu = coords.detach().cpu()
+    for idx, coord in enumerate(coords_cpu.tolist()):
+        key = tuple(coord)
+        if key in coord_to_idx:
+            raise ValueError(f"Duplicate dual-grid coordinate is not supported: {key}")
+        coord_to_idx[key] = idx
+
+    edge_neighbor_voxel = coords.reshape(coords.shape[0], 1, 1, 3) + edge_neighbor_voxel_offset
+    connected_voxel = edge_neighbor_voxel[intersected_flag]
+    if connected_voxel.numel() == 0:
+        return (
+            torch.zeros(0, 3, dtype=dual_vertices.dtype, device=device),
+            torch.zeros(0, 3, dtype=torch.long, device=device),
+        )
+
+    connected_indices = []
+    for coord in connected_voxel.detach().cpu().reshape(-1, 3).tolist():
+        connected_indices.append(coord_to_idx.get(tuple(coord), -1))
+    connected_indices = torch.tensor(connected_indices, dtype=torch.long, device=device).reshape(-1, 4)
+    quad_indices = connected_indices[(connected_indices >= 0).all(dim=1)]
+    if quad_indices.numel() == 0:
+        return (
+            torch.zeros(0, 3, dtype=dual_vertices.dtype, device=device),
+            torch.zeros(0, 3, dtype=torch.long, device=device),
+        )
+
+    mesh_vertices = (coords.to(dtype=dual_vertices.dtype) + dual_vertices) * voxel_size + aabb[0].reshape(1, 3)
+
+    if split_weight is None:
+        split_1 = quad_indices[:, quad_split_1]
+        n0 = torch.linalg.cross(
+            mesh_vertices[split_1[:, 1]] - mesh_vertices[split_1[:, 0]],
+            mesh_vertices[split_1[:, 2]] - mesh_vertices[split_1[:, 0]],
+            dim=1,
+        )
+        n1 = torch.linalg.cross(
+            mesh_vertices[split_1[:, 2]] - mesh_vertices[split_1[:, 1]],
+            mesh_vertices[split_1[:, 3]] - mesh_vertices[split_1[:, 1]],
+            dim=1,
+        )
+        align_1 = (n0 * n1).sum(dim=1, keepdim=True).abs()
+
+        split_2 = quad_indices[:, quad_split_2]
+        n0 = torch.linalg.cross(
+            mesh_vertices[split_2[:, 1]] - mesh_vertices[split_2[:, 0]],
+            mesh_vertices[split_2[:, 2]] - mesh_vertices[split_2[:, 0]],
+            dim=1,
+        )
+        n1 = torch.linalg.cross(
+            mesh_vertices[split_2[:, 2]] - mesh_vertices[split_2[:, 1]],
+            mesh_vertices[split_2[:, 3]] - mesh_vertices[split_2[:, 1]],
+            dim=1,
+        )
+        align_2 = (n0 * n1).sum(dim=1, keepdim=True).abs()
+
+        mesh_faces = torch.where(align_1 > align_2, split_1, split_2).reshape(-1, 3)
+    else:
+        split_weight = split_weight.to(device=device)
+        sw = split_weight[quad_indices]
+        sw_02 = (sw[:, 0] * sw[:, 2]).reshape(-1)
+        sw_13 = (sw[:, 1] * sw[:, 3]).reshape(-1)
+        cond = (sw_02 > sw_13).unsqueeze(1).expand(-1, 6)
+        mesh_faces = torch.where(cond, quad_indices[:, quad_split_1], quad_indices[:, quad_split_2]).reshape(-1, 3)
+
+    return mesh_vertices, mesh_faces
