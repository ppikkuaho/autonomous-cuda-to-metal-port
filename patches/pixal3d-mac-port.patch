+def sample_vertex_base_colors(mesh, pipeline) -> tuple[np.ndarray, float]:
+    vertices = mesh.vertices.detach().cpu().numpy().astype(np.float32)
+    attrs = mesh.attrs.detach().cpu().numpy().astype(np.float32)
+    coords = mesh.coords.detach().cpu().numpy().astype(np.int64)
+    layout = getattr(mesh, "layout", None) or pipeline.pbr_attr_layout
+    base_color_slice = layout.get("base_color", slice(0, 3))
+    default_color = np.array([0.72, 0.72, 0.72], dtype=np.float32)
+    colors = np.tile(default_color, (vertices.shape[0], 1))
+
+    if attrs.size == 0 or coords.size == 0:
+        return np.clip(colors, 0.0, 1.0), 0.0
+
+    attr_colors = np.clip(attrs[:, base_color_slice], 0.0, 1.0)
+    origin = mesh.origin.detach().cpu().numpy().astype(np.float32)
+    continuous = (vertices - origin) / float(mesh.voxel_size)
+    max_coord = int(max(coords.max(initial=0), np.ceil(continuous).max(initial=0))) + 2
+    max_coord = max(max_coord, 2)
+
+    coord_hash = _coord_hash(coords, max_coord)
+    order = np.argsort(coord_hash)
+    sorted_hash = coord_hash[order]
+    matched = np.zeros(vertices.shape[0], dtype=bool)
+
+    def apply_lookup(query_coords: np.ndarray) -> None:
+        nonlocal matched
+        missing = np.flatnonzero(~matched)
+        if len(missing) == 0:
+            return
+        query = np.clip(query_coords[missing], 0, max_coord - 1).astype(np.int64)
+        query_hash = _coord_hash(query, max_coord)
+        pos = np.searchsorted(sorted_hash, query_hash)
+        in_bounds = pos < sorted_hash.shape[0]
+        valid = np.zeros_like(in_bounds, dtype=bool)
+        if np.any(in_bounds):
+            valid[in_bounds] = sorted_hash[pos[in_bounds]] == query_hash[in_bounds]
+        if not np.any(valid):
+            return
+        vertex_ids = missing[valid]
+        colors[vertex_ids] = attr_colors[order[pos[valid]]]
+        matched[vertex_ids] = True
+
+    apply_lookup(np.rint(continuous).astype(np.int64))
+    floor_coords = np.floor(continuous).astype(np.int64)
+    for dx in (0, 1):
+        for dy in (0, 1):
+            for dz in (0, 1):
+                apply_lookup(floor_coords + np.array([dx, dy, dz], dtype=np.int64))
+
+    return np.clip(colors, 0.0, 1.0), float(matched.mean()) if len(matched) else 0.0
+
+
+def _coord_hash(coords: np.ndarray, base: int) -> np.ndarray:
+    coords = coords.astype(np.int64, copy=False)
+    return coords[:, 0] * base * base + coords[:, 1] * base + coords[:, 2]
+
+
+def build_vertex_color_texture(
+    vertices: np.ndarray,
+    colors: np.ndarray,
+    texture_size: int = 1024,
+) -> tuple[np.ndarray, np.ndarray]:
+    centered = vertices - (vertices.min(axis=0) + vertices.max(axis=0)) / 2
+    radius = np.linalg.norm(centered[:, [0, 2]], axis=1)
+    u = (np.arctan2(centered[:, 2], centered[:, 0]) / (2 * np.pi) + 0.5) % 1.0
+    y_min = centered[:, 1].min()
+    y_span = max(float(centered[:, 1].max() - y_min), 1e-6)
+    v = np.clip((centered[:, 1] - y_min) / y_span, 0.0, 1.0)
+    uv = np.stack([u, v], axis=1).astype(np.float32)
+
+    texture = np.full((texture_size, texture_size, 3), 184, dtype=np.uint8)
+    px = np.clip((uv[:, 0] * (texture_size - 1)).astype(np.int32), 0, texture_size - 1)
+    py = np.clip(((1.0 - uv[:, 1]) * (texture_size - 1)).astype(np.int32), 0, texture_size - 1)
+    order = np.argsort(radius)
+    texture[py[order], px[order]] = np.clip(colors[order, :3] * 255, 0, 255).astype(np.uint8)
+    return texture, uv
+
