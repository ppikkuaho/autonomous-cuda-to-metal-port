new file mode 100644
index 0000000..3ca9cf0
--- /dev/null
+++ b/natten/functional.py
@@ -0,0 +1,20 @@
+from natten_mps import na2d_av as _na2d_av
+from natten_mps import na2d_qk as _na2d_qk
+
+
+def na2d_qk(query, key, kernel_size, dilation=1, **kwargs):
+    """Compatibility wrapper for legacy NATTEN [B, heads, H, W, dim] tensors."""
+    query = query.permute(0, 2, 3, 1, 4).contiguous()
+    key = key.permute(0, 2, 3, 1, 4).contiguous()
+    out = _na2d_qk(query, key, kernel_size=kernel_size, dilation=dilation, **kwargs)
+    return out.permute(0, 3, 1, 2, 4).contiguous()
+
+
+def na2d_av(attn, value, kernel_size, dilation=1, **kwargs):
+    """Compatibility wrapper for legacy NATTEN [B, heads, H, W, *] tensors."""
+    attn = attn.permute(0, 2, 3, 1, 4).contiguous()
+    value = value.permute(0, 2, 3, 1, 4).contiguous()
+    out = _na2d_av(attn, value, kernel_size=kernel_size, dilation=dilation, **kwargs)
+    return out.permute(0, 3, 1, 2, 4).contiguous()
+
+__all__ = ["na2d_av", "na2d_qk"]
